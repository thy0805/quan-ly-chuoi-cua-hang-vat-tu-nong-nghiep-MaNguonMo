#!/usr/bin/env php
<?php

use App\Support\RuntimeIsolation;
use Symfony\Component\Console\Input\ArgvInput;

require_once __DIR__.'/app/Support/RuntimeIsolation.php';

if (! RuntimeIsolation::allowsCommand($argv)) {
    fwrite(STDERR, "MNM: lệnh hoặc tham số nằm ngoài phạm vi G4A được duyệt.\n");
    exit(78);
}

if (! is_file(__DIR__.'/vendor/autoload.php')) {
    fwrite(STDERR, "MNM G3: chưa cài dependency; chưa xác minh Laravel boot.\n");
    exit(78);
}

define('LARAVEL_START', microtime(true));
require __DIR__.'/vendor/autoload.php';
$app = require_once __DIR__.'/bootstrap/app.php';
exit($app->handleCommand(new ArgvInput));
